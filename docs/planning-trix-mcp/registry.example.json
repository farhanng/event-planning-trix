{
  "_comment": "Registry contoh — Planning Trix MCP. Satu baris per tab. kind: Aktif | Referensi | Arsip. headerRow = baris header kolom. revRow = baris tempat 'Rev. <tanggal>' ditulis. columns memetakan field kanonik -> huruf kolom. Tab kind 'Arsip' ditolak jalur tulis. Nama tab straight-forward, tanpa embel 'Draft'/'2026'.",

  "environment": {
    "dev": { "spreadsheetIdEnv": "PTX_SPREADSHEET_ID_DEV", "access": "editor" },
    "prod": { "spreadsheetIdEnv": "PTX_SPREADSHEET_ID_PROD", "access": "viewer" }
  },

  "statusEnum": ["Belum Mulai", "Proses", "Terblokir", "Selesai", "Batal", "N/A"],
  "paymentEnum": ["Belum Bayar", "DP", "Lunas"],
  "zonaEnum": ["Main Hall", "Workshop", "Auditorium"],
  "priorityEnum": ["High", "Mid", "Low"],

  "statusMap": {
    "Not Started": "Belum Mulai",
    "To do": "Belum Mulai",
    "TBC": "Belum Mulai",
    "In-Progress": "Proses",
    "In Progress": "Proses",
    "On Progress": "Proses",
    "PROCESS": "Proses",
    "Doing": "Proses",
    "Done": "Selesai",
    "Completed": "Selesai",
    "Aktif": "Selesai",
    "LUNAS": "Lunas"
  },

  "tabs": [
    {
      "title": "Index & Standar",
      "kind": "Aktif",
      "entity": "index",
      "headerRow": 4,
      "columns": {
        "tab": "A", "kind": "B", "purpose": "C", "issues": "D",
        "owner": "E", "action": "F", "link": "G"
      }
    },
    {
      "title": "Overview",
      "kind": "Aktif",
      "entity": "event_profile",
      "headerRow": 2,
      "columns": { "field": "A", "value": "B", "remarks": "C" }
    },
    {
      "title": "Task",
      "kind": "Aktif",
      "entity": "task",
      "headerRow": 4,
      "columns": {
        "id": "A", "task": "B", "division": "C", "pic": "D",
        "deadline": "E", "priority": "F", "status": "G", "note": "H"
      }
    },
    {
      "title": "Budget",
      "kind": "Aktif",
      "entity": "budget_line",
      "headerRow": 4,
      "revRow": 2,
      "columns": {
        "category": "A", "item": "B", "qty": "C", "unit": "D",
        "unit_price": "E", "total": "F", "note": "G"
