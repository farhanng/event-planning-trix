  "tabs": {
    "_comment": "Contoh untuk event devfest26. Event lain punya file registry sendiri (lihat events[].registryFile) karena nama & jumlah tab beda (2026: 57 tab, 2025: 41 tab, Cloud Next 2026: 31 tab).",

    "Overview": {
      "kind": "Aktif",
      "entity": "event",
      "headerRow": 2,
      "revRow": 2,
      "columns": { "field": "A", "value": "B", "remarks": "C" },
      "note": "Baris Resources/Forms -> EVENT_REFERENCE; Goals -> target di EVENT."
    },
    "Index & Standar": {
      "kind": "Aktif",
      "entity": "event_tab",
      "headerRow": 4,
      "revRow": 2,
      "columns": {
        "tab": "A", "kind": "B", "purpose": "C", "issues": "D",
        "owner_pic": "E", "action": "F", "link": "G"
      }
    },
    "Budget 2026 (Draft)": {
      "kind": "Aktif",
      "entity": "budget_line",
      "headerRow": 4,
      "revRow": 2,
      "columns": {
        "category": "A", "item": "B", "qty": "C", "unit": "D",
        "unit_price_idr": "E", "total_idr": "F", "note": "G"
      }
    },
    "Budget 2026 - In Out": {
      "kind": "Turunan",
      "derivedFrom": "Budget 2026 (Draft)",
      "entity": "budget_summary",
      "headerRow": 4,
      "revRow": 2,
